# Ignore env file
env/

# Ignore python cache
*.pyc
__pycache__/
*.joblib

# Ignore pkl files
*.pkl

# Ignore bench results
bench/results/

# VSCode
.vscode

# AI agent cache files
.claude/
.codex/
.cursor/
.copilot/
.aider*
.continue/

# Personal session context (not part of upstream)
CONTEXT.md

# Ignore generated workload traces
workloads/azure_trace_*.jsonl

# Track A / B post-simulation analysis raw outputs
# (re-generated by analyze_steady_state_v0.py from per-request CSVs)
outputs/**/*_concurrent_decode.csv
outputs/**/*_concurrent_decode.png
outputs/**/*_decode_events.csv

# Smoke test outputs for P1 patch validation
# (regenerable; not part of the result set)
outputs/custom_pdd_run_req_100_P1*

# Simulation raw outputs — regenerable by re-running the simulation
# Only *_steady_summary.json is committed as the canonical result.
outputs/custom_pdd_run_req_*.csv
outputs/custom_pdd_run_req_*.log
outputs/custom_pdd_run_req_*_timeseries.csv
outputs/custom_pdd_run_req_*_decode_pool_ts.csv
outputs/custom_pdd_run_req_*_decode_pool_ts.png

# D2D link contention simulation raw outputs — regenerable
# Only *_steady_summary.json is committed as the canonical result.
outputs/custom_pdd_d2d_req_*.csv
outputs/custom_pdd_d2d_req_*.log
outputs/custom_pdd_d2d_req_*_timeseries.csv
outputs/custom_pdd_d2d_req_*_decode_pool_ts.csv
outputs/custom_pdd_d2d_req_*_decode_pool_ts.png

# Load scaling experiment raw outputs — regenerable by re-running run_load_scale.sh
# comparison_summary.json and comparison.png are committed as canonical results.
outputs/load_scale_exp/scale*.csv
outputs/load_scale_exp/scale*.log
outputs/load_scale_exp/scale*_timeseries.csv
outputs/load_scale_exp/all_runs.log

# Root-level simulator log
sim.log
outputs/load_scale_exp/comparison.png
